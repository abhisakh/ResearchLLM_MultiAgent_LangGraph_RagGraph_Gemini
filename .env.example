# Copy this file to ".env" in the repository root and fill in your keys.
# The real .env is git-ignored and must never be committed.

# --- Required ---
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Optional ---
# Gemini model used for generation (default: models/gemini-3.6-flash)
LLM_MODEL=models/gemini-3.6-flash

# Models to try, in order, when the daily quota of LLM_MODEL is used up (comma-separated, empty = none).
# Quotas are counted per model, so a lighter model still has its own allowance. Use model names
# exactly as Google AI Studio lists them for your key.
LLM_MODEL_FALLBACKS=

# Gemini requests allowed per minute for one model. The app then waits before sending a request that would go
# over, instead of provoking HTTP 429 errors. Set it to the per-minute limit AI Studio shows for your model
# (https://aistudio.google.com/rate-limit). The free tier of some models allows only 5, and one question needs
# at least 6 calls (clean query, intent, planning, query generation, synthesis, evaluation), so without this a
# free-tier run fails by design. A paced run takes about a minute longer per 5 calls. 0 or empty = no pacing.
LLM_REQUESTS_PER_MINUTE=0

# Contact emails sent with public API requests. Use real addresses:
# NCBI (PubMed) may throttle or block anonymous clients, and OpenAlex gives
# faster responses ("polite pool") to requests that carry an email.
# Plain address only, no "mailto:" prefix.
ENTREZ_EMAIL=
OPENALEX_EMAIL=

# Materials Project key, needed only for material-property queries
MP_API_KEY=

# Semantic Scholar key (free, https://www.semanticscholar.org/product/api).
# Without it the public tier is heavily rate limited and the Semantic Scholar tool often returns nothing.
S2_API_KEY=

# Embedding backend: "local" (all-MiniLM-L6-v2, default) or "gemini"
EMBEDDING_PROVIDER=local

# Folder for the FAISS index (vector_index.faiss, vector_data.pkl).
# Leave empty to use the repository root.
VECTOR_DATA_DIR=

# Log verbosity: DEBUG, INFO (default), WARNING or ERROR
LOG_LEVEL=INFO
